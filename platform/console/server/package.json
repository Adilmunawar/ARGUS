{
  "name": "argus-console-server",
  "version": "0.1.0",
  "private": true,
  "description": "The Argus console API: real host telemetry and real AWS inventory, for managing the estate during and after the AWS exit.",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test/smoke.js && node test/auth.js && node test/streams.js && node test/storage.js",
    "test:smoke": "node test/smoke.js",
    "test:auth": "node test/auth.js",
    "test:streams": "node test/streams.js",
    "hash-operator-password": "node src/auth/hash-password.js",
    "test:storage": "node test/storage.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-cost-explorer": "^3.700.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-rds": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "pg": "^8.16.3",
    "yaml": "^2.9.0"
  }
}
