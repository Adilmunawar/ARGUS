{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceAccounts",
  "type": "object",
  "required": ["apiVersion", "kind", "accounts"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "argus/v1" },
    "kind": { "const": "ServiceAccounts" },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "hosts", "tier"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^(gmsa-[a-z0-9-]+\\$|svc-[a-z0-9-]+)$" },
          "hosts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\*)?$" }
          },
          "tier": { "type": "integer", "minimum": 0, "maximum": 2 },
          "kind": { "type": "string", "enum": ["linux-sssd"] },
          "sql": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
          },
          "s3": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:(r|rw|put-only)$" }
          },
          "codesign": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
