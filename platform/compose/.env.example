TZ=Asia/Karachi
ARGUS_VERSION=0.1.0
ARGUS_SITE=site-a
ARGUS_ENVIRONMENT=sandbox
ARGUS_PROFILE=dev
ARGUS_ALLOW_WRITES=0
ARGUS_SUBNET=172.28.0.0/16
ARGUS_SUBNET_REGEX=^172\.28\..*$

CONSOLE_PORT=8787
PG_PORT=5432
GARNET_PORT=6379
NATS_PORT=4222
OPENBAO_PORT=8200

SEAWEEDFS_TAG=3.97
POSTGIS_TAG=17-3.5
GARNET_TAG=2.1.5
NATS_TAG=2.11.4-alpine
NATS_BOX_TAG=0.17.0
VALKEY_TAG=9.1.2-alpine
OPENBAO_TAG=2.6.2
ALPINE_TAG=3.21
NODE_TAG=22-bookworm-slim
PROMETHEUS_TAG=v3.5.0
ALERTMANAGER_TAG=v0.28.1
LOKI_TAG=3.5.0
ALLOY_TAG=v1.9.1
GRAFANA_TAG=12.0.2
MAILPIT_TAG=v1.27
LOCALSTACK_TAG=4.14.0
NODE_EXPORTER_TAG=v1.9.1
PG_EXPORTER_TAG=v0.17.1
REDIS_EXPORTER_TAG=v1.69.0-alpine
NATS_EXPORTER_TAG=0.17.3
SOCKET_PROXY_TAG=v0.5.0
GUAC_TAG=1.5.5
OPENSSH_TAG=version-9.9_p2-r0
RDESKTOP_TAG=ubuntu-xfce
NOMAD_TAG=1.11.3
AZURITE_TAG=3.37.0

ARGUS_S3_REGION=us-east-1
ARGUS_S3_VOLUME_SIZE_MB=1024
ARGUS_S3_MAX_VOLUMES=60
ARGUS_OBJECT_LOCK_DAYS=1
ARGUS_DEV_LOCK_MODE=GOVERNANCE
ARGUS_S3_ADMIN_SECRET=replace-me
ARGUS_S3_CONSOLE_SECRET=replace-me
ARGUS_S3_APP_SECRET=replace-me
ARGUS_S3_LOKI_SECRET=replace-me
ARGUS_S3_GUAC_SECRET=replace-me
ARGUS_S3_PARITY_SECRET=replace-me
ARGUS_S3_PARITY_DENY_SECRET=replace-me
ARGUS_S3_PARITY_ADMIN_SECRET=replace-me

PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=120
ARGUS_PG_APP_PASSWORD=replace-me
ARGUS_PG_CONSOLE_PASSWORD=replace-me
ARGUS_PG_EXPORTER_PASSWORD=replace-me
ARGUS_PG_GUAC_PASSWORD=replace-me
ARGUS_PG_GRAFANA_PASSWORD=replace-me
ARGUS_PG_PARITY_PASSWORD=replace-me

GARNET_MEM_LIMIT=768m
ARGUS_GARNET_MEM_LIMIT_BYTES=805306368
GARNET_CONSOLE_PASSWORD=replace-me

NATS_ARGUS_PASSWORD=replace-me
NATS_AGENT_PASSWORD=replace-me

ARGUS_UNSEAL_MODE=sandbox

PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=6GB
LOKI_RETENTION_DEFAULT=360h
GRAFANA_ADMIN_USER=argus-admin
SMTP_HOST=mailpit:1025
ONCALL_EMAIL=oncall@example.invalid

GUAC_JSON_SECRET_KEY=replace-me-32-hex-chars
GUAC_BREAKGLASS_USER=argus-breakglass
GUAC_BREAKGLASS_SALT_HEX=replace-me
GUAC_BREAKGLASS_HASH_HEX=replace-me
TARGET_SSH_PASSWORD=replace-me

ARGUS_NOMAD_DATA=/opt/argus/nomad/data
AZURITE_ACCOUNT_KEY=replace-me-base64

ARGUS_UPSTREAM_TIMEOUT_MS=8000
