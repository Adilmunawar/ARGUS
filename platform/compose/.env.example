# platform/compose/.env.example  ->  copy to .env via bootstrap.ps1
#
# .env is ALREADY gitignored (line 6 of the repo .gitignore, verified).
# ./secrets/ is NOT — bootstrap.ps1 appends `platform/compose/secrets/` to
# .gitignore, because the existing rules cover *.key, *.pem and .env but NOT
# extensionless files like `pg_superuser_password`.
#
# NEVER commit a real value here. CI (.github/workflows/validate.yml) greps for
# credential-shaped strings and will fail the build on a literal password.
#
# bootstrap.ps1 generates every SECRET below and REFUSES to overwrite an
# existing .env — regenerating rotates passwords underneath a running stack:
# Grafana ignores a changed admin password after first boot (you are locked
# out), a changed pg password does not match the role, and a changed webhook
# token 401s every alert.
#
# PowerShell 5.1 NOTE (this is what is on the target box):
#   [RandomNumberGenerator]::GetBytes(n) is a .NET 6+ static and THROWS on 5.1.
#   Use: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   And write the file with [IO.File]::WriteAllText($p,$s,(New-Object Text.UTF8Encoding $false))
#   — Out-File on 5.1 emits UTF-16LE or a BOM, which docker compose cannot parse.

# ─────────────────────────────────────────────────────────── stack identity
TZ=Asia/Karachi                     # container timezone; mill reports are read against a local working day
ARGUS_VERSION=0.1.0                 # tag for the locally built argus/console-api image (ADR-0006: no registry, build locally)
ARGUS_SITE=site-a                   # Prometheus external_label; distinguishes this data if it is ever merged with Site B
ARGUS_ENVIRONMENT=sandbox           # Prometheus external_label; never set this to "production" on a laptop
ARGUS_PROFILE=dev                   # dev collapses object-lock retention to 1 day and COMPLIANCE to GOVERNANCE
ARGUS_ALLOW_WRITES=0                # 0 = console refuses every non-GET with 405 before route lookup. Every write endpoint is inert until this is 1
ARGUS_SUBNET=172.28.0.0/16          # pinned because Guacamole JSON_TRUSTED_NETWORKS needs a fixed range. RUN `route print` FIRST: if a VPN routes this, change it or you blackhole the VPN
ARGUS_SUBNET_REGEX=^172\.28\..*$    # derived from ARGUS_SUBNET by bootstrap.ps1; Guacamole RemoteIpValve needs a regex, not a CIDR, and a hardcoded one silently audits every session as coming from the proxy

# ─────────────────────────────────────────────────────── published host ports
# All bind 127.0.0.1 only. Use the LITERAL 127.0.0.1 in every client — the
# publishes are IPv4-only and Node 18+/Windows resolve `localhost` to ::1 first,
# which fails with ECONNREFUSED against a service that is running perfectly.
CONSOLE_PORT=8787                   # the only port an operator's browser touches
PG_PORT=5432                        # change to 5442 if a native EDB PostgreSQL already owns 5432
GARNET_PORT=6379                    # change if Memurai or a stray WSL redis-server owns it; a collision is a hard bind failure
NATS_PORT=4222                      # check `netsh int ipv4 show excludedportrange protocol=tcp` — Hyper-V reserves ranges and the error reads like "something else is listening"
OPENBAO_PORT=8200                   # OpenBao API and web UI; the UI is required to seed kv values and for OIDC login

# ─────────────────────────────────────────── image tags (pin to digests in CI)
# Every tag here was chosen deliberately and several are load-bearing. Resolve
# each to a sha256 digest at bootstrap and record it in images.lock; CI should
# fail if the lock is older than 90 days. A tag that has moved fails at pull
# time with the stack half-up.
SEAWEEDFS_TAG=3.97                  # object-lock feature floor is ~3.90; below it CreateBucket accepts ObjectLockEnabledForBucket and SILENTLY ignores it
POSTGIS_TAG=17-3.5                  # PostGIS is why ADR-0008 added Postgres. A base-image change can alter glibc and silently invalidate text indexes — REINDEX after any bump
GARNET_TAG=2.1.5                    # NOT the -chiseled variant: it has no shell and the /dev/tcp healthcheck cannot run
NATS_TAG=2.11.4-alpine              # the -alpine suffix is LOAD-BEARING: the default tag is scratch, no busybox wget, healthcheck fails forever
NATS_BOX_TAG=0.17.0                 # the `nats` CLI lives here; the nats server image ships nats-server ONLY
VALKEY_TAG=9.1.2-alpine             # valkey-cli, used only to verify Garnet's RESP surface and ACLs
OPENBAO_TAG=2.6.2                   # verified on GHCR; note the ~monthly release cadence, so re-pin deliberately
ALPINE_TAG=3.21                     # the guacamole volume-ownership one-shot; base image only, NO su-exec (it is a package)
NODE_TAG=22-bookworm-slim           # floating minor on purpose: a stale patch tag is never rebuilt and accumulates CVEs
PROMETHEUS_TAG=v3.5.0
ALERTMANAGER_TAG=v0.28.1
LOKI_TAG=3.5.0
ALLOY_TAG=v1.9.1
GRAFANA_TAG=12.0.2
MAILPIT_TAG=v1.27
LOCALSTACK_TAG=4.14.0                # the LAST Community release: from 2026-03-23 the latest tag requires a paid auth token, and a parity baseline that moves underneath you produces unexplainable red runs
NODE_EXPORTER_TAG=v1.9.1
PG_EXPORTER_TAG=v0.17.1             # verify busybox wget exists in this image; if distroless, set healthcheck disable:true rather than leave a red row
REDIS_EXPORTER_TAG=v1.69.0-alpine   # -alpine, not the default scratch build
NATS_EXPORTER_TAG=0.17.3
SOCKET_PROXY_TAG=v0.5.0             # v-prefixed scheme; 0.3.0 is two minors behind. Verify the env-var interface on v0.5.0
GUAC_TAG=1.5.5                      # 1.6.0 is plausible but unverified. A non-existent tag is a boot failure; an older patch is only an upgrade
OPENSSH_TAG=version-9.9_p2-r0       # LinuxServer publishes version-<upstream>; a bare 9.9_p2-r0 will 404 at pull time
RDESKTOP_TAG=ubuntu-xfce
NOMAD_TAG=1.11.3                    # CE stops at 1.9.7 on the 1.9 line — 1.9.8+ are -ent only. 1.11.3 is the last CE 1.x
AZURITE_TAG=3.37.0

# ────────────────────────────────────────────────── object storage (SeaweedFS)
# S3 ACCESS KEYS ARE IDENTIFIERS, NOT SECRETS, so they are hardcoded in
# s3.json (argus-admin, argus-console, argus-app, ...) and only the secret half
# is generated. Halves what bootstrap manages.
ARGUS_S3_REGION=us-east-1           # SeaweedFS ignores it; SigV4 requires one. Must match every client
ARGUS_S3_VOLUME_SIZE_MB=1024        # ceiling = this x ARGUS_S3_MAX_VOLUMES. Past it, writes fail "no writable volumes" with the disk half empty
ARGUS_S3_MAX_VOLUMES=60             # 60 x 1024 MB = ~60 GB on this node. Raise BOTH together or neither
ARGUS_OBJECT_LOCK_DAYS=1            # dev only; buckets.yaml declares the real 35/365/400. Refused on any profile but dev
ARGUS_DEV_LOCK_MODE=GOVERNANCE      # dev only; bypassable with x-amz-bypass-governance-retention. COMPLIANCE on a laptop is a one-way door
ARGUS_S3_ADMIN_SECRET=replace-me    # full admin; used by storage-init only, never by the console
ARGUS_S3_CONSOLE_SECRET=replace-me  # Read+List scoped BUCKET-BY-BUCKET, no Write anywhere — a bucket added later is not auto-exposed
ARGUS_S3_APP_SECRET=replace-me      # the application identity (mills/ml): read+write on the data buckets, nothing on backups/logs/sessions
ARGUS_S3_LOKI_SECRET=replace-me     # argus-logs only; owner is gmsa-loki$ in buckets.yaml
ARGUS_S3_GUAC_SECRET=replace-me     # argus-sessions only; recorded RDP video and KEYSTROKES — classify with OpenBao, not with logs
ARGUS_S3_PARITY_SECRET=replace-me   # the parity harness's own buckets; never touches a production bucket
ARGUS_S3_PARITY_DENY_SECRET=replace-me  # DELIBERATELY UNDER-PRIVILEGED. Every call with it is expected to FAIL; a 200 is the defect
ARGUS_S3_PARITY_ADMIN_SECRET=       # SeaweedFS gates CreateBucket, bucket encryption and public-access-block on GLOBAL Admin, so the bucket-CRUD legs need their own credential and must never share the one doing the bulk of the run

# ─────────────────────────────────────────────────────────── PostgreSQL / RDS
PG_SHARED_BUFFERS=256MB             # laptop value. pg-01 is 16GB — do not size production from a benchmark taken here
PG_EFFECTIVE_CACHE_SIZE=768MB       # a hint to the planner, not an allocation
PG_WORK_MEM=8MB                     # PER SORT NODE, not per connection. Four sorts x fifty connections is how a tuned Postgres OOMs
PG_MAX_CONNECTIONS=120              # sum of per-database CONNECTION LIMITs plus reserves must stay under this
ARGUS_PG_APP_PASSWORD=replace-me         # argus_app: owns argus_geo / argus_ml, read-write
ARGUS_PG_CONSOLE_PASSWORD=replace-me     # argus_console: pg_monitor + explicit CONNECT + default_transaction_read_only
ARGUS_PG_EXPORTER_PASSWORD=replace-me    # argus_exporter: pg_monitor only — sees that a query is slow, never what is in it
ARGUS_PG_GUAC_PASSWORD=replace-me        # guacamole_user: owns guacamole_db and nothing else
ARGUS_PG_GRAFANA_PASSWORD=replace-me     # grafana: its own database, so two Grafanas can share it at Site A
ARGUS_PG_PARITY_PASSWORD=replace-me      # argus_parity: the restart-canary table only

# ──────────────────────────────────────────────────────────── cache (Garnet)
GARNET_MEM_LIMIT=768m                    # the ONLY backstop: Garnet has no maxmemory and no eviction, it spills to disk
ARGUS_GARNET_MEM_LIMIT_BYTES=805306368   # MUST equal GARNET_MEM_LIMIT in bytes. The console cannot read the cgroup and has no other denominator
GARNET_CONSOLE_PASSWORD=replace-me       # console ACL user: no +get, no flushall, no config|set. It cannot read or wipe the cache

# ─────────────────────────────────────────────── queues (NATS JetStream)
# NATS expands $VAR from its environment and REFUSES TO START if one is unset —
# the behaviour you want, because no default password can exist.
NATS_ARGUS_PASSWORD=replace-me      # applications and nats-init
NATS_AGENT_PASSWORD=replace-me      # the console's DLQ collector and lag reader. NOTE: per-subject permissions are NOT yet applied, so this is equivalent to argus inside the account

# ────────────────────────────────────────────────────── secrets (OpenBao)
ARGUS_UNSEAL_MODE=sandbox           # sandbox = 1-of-1 auto-unseal, KEY ON THE SAME MACHINE AS THE DATA (console shows a permanent red banner). ceremony = 5-of-3, two-pass, no key at rest — what ADR-0013 actually requires

# ────────────────────────────────────────────── observability (profile)
PROM_RETENTION_TIME=15d             # the SIZE cap below usually wins first and does so silently
PROM_RETENTION_SIZE=6GB             # at ~50k series/15s this is ~10 days, not 15. Alert on it rather than assume
LOKI_RETENTION_DEFAULT=360h         # 15 days. Site A wants 9600h for security streams and 2160h for argus.ai.audit
GRAFANA_ADMIN_USER=argus-admin      # the password is a FILE secret, not an env var — the socket proxy exposes env
SMTP_HOST=mailpit:1025              # rendered INTO alertmanager.yml by bootstrap. Alertmanager does NOT expand env vars: a ${} left in that file is taken literally and the fallback delivery leg dies silently
ONCALL_EMAIL=oncall@example.invalid # same — the SMTP leg exists precisely to work when the console is down

# ──────────────────────────────────────────── browser RDP/SSH (profile connect)
GUAC_JSON_SECRET_KEY=replace-me-32-hex-chars  # TIER-0: whoever holds this mints a session as anyone to anything. EXACTLY 32 hex chars = 128 bits; any other length is rejected
GUAC_BREAKGLASS_USER=argus-breakglass         # replaces the publicly-known guacadmin/guacadmin default
GUAC_BREAKGLASS_SALT_HEX=replace-me           # 32 random bytes as hex
GUAC_BREAKGLASS_HASH_HEX=replace-me           # SHA256(password_utf8 + UPPERCASE_HEX(salt)) — computed in bootstrap so no plaintext reaches SQL or a log
TARGET_SSH_PASSWORD=replace-me                # sandbox SSH target. PASSWORD_ACCESS is deliberately on: the credential-injection path is the thing being proved

# ──────────────────────────────────────────────────── compute (profile compute)
# ⚠ Requires Docker Engine installed NATIVELY in the WSL2 distro. Under Docker
# Desktop, Nomad's alloc-dir bind mounts resolve in a different VM and every
# task gets empty alloc/local/secrets dirs, with no error that says so.
ARGUS_NOMAD_DATA=/opt/argus/nomad/data   # MUST be absolute and mounted at the IDENTICAL path inside the container, on the distro's own ext4 — never under /mnt/c
AZURITE_ACCOUNT_KEY=replace-me-base64    # must be valid base64. Azurite is a DEVELOPMENT EMULATOR — the one genuinely fake component here

# ───────────────────────────────────── console upstream overrides (rarely set)
# Defaults point at compose service names and are correct in-network. Override
# only when running the console on the Windows host with `npm start`, in which
# case use 127.0.0.1 literals and note that host.js will then report the Windows
# machine rather than the WSL2 VM.
ARGUS_UPSTREAM_TIMEOUT_MS=8000      # a hung upstream must not become a hung dashboard
# ARGUS_PROM_URL=http://prometheus:9090
# ARGUS_LOKI_URL=http://loki:3100
# ARGUS_ALERTMANAGER_URL=http://alertmanager:9093
# ARGUS_GUACAMOLE_BASE=http://guacamole:8080/guacamole
# ARGUS_PARITY_URL=http://parity:9781
# ARGUS_NOMAD_URL=http://nomad:4646
