{
  "uid": "argus-logs",
  "title": "Argus Log Volume",
  "tags": ["argus", "logs"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "argus-loki" },
        "query": { "label": "service_name", "refId": "service", "stream": "", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "argus-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "argus-loki" },
          "expr": "sum by (level) (rate({service_name=~\"$service\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log volume by service",
      "description": "The noisiest service is the one that will hit per_stream_rate_limit first and have its lines discarded rather than delayed.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "argus-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "argus-loki" },
          "expr": "topk(10, sum by (service_name) (rate({service_name=~\"$service\"} [$__auto])))",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors in range",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "argus-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "argus-loki" },
          "expr": "sum(count_over_time({service_name=~\"$service\", level=~\"error\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Entries shipped and dropped by Alloy",
      "description": "Dropped entries are gone, not delayed. A non-zero drop line means Loki refused the push after every retry.",
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "argus-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "argus-prometheus" },
          "expr": "sum(rate(loki_write_sent_entries_total[5m]))",
          "legendFormat": "sent"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "argus-prometheus" },
          "expr": "sum(rate(loki_write_dropped_entries_total[5m]))",
          "legendFormat": "dropped"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "argus-prometheus" },
          "expr": "sum by (reason) (rate(loki_process_dropped_lines_total[5m]))",
          "legendFormat": "redaction drop {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "dropped" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Lines",
      "description": "Credential-shaped strings are redacted by Alloy at write time, so they were never stored. trace_id, span_id and request_id are structured metadata: filter with | trace_id=\"...\" rather than as a stream label.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "argus-loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "argus-loki" },
          "expr": "{service_name=~\"$service\", level=~\"$level\"} |= \"$search\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
